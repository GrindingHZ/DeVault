generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  VAULT_STAFF
  OPERATIONS
  COMPLIANCE

  @@map("role")
}

model Account {
  id            String   @id
  email         String   @unique
  passwordHash  String   @map("password_hash")
  walletAddress String?  @unique @map("wallet_address")
  roles         Role[]
  version       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions Session[]

  @@map("account")
}

model WalletChallenge {
  id        String    @id
  nonce     String
  address   String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([address, usedAt])
  @@map("wallet_challenge")
}

model Session {
  id        String   @id
  accountId String   @map("account_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@map("session")
}

/**
 * One row, id fixed, because the system is either paused or it is not. A
 * pause has no effective date, unlike the protocol parameters.
 */
model SystemState {
  id                String    @id
  pausedAt          DateTime? @map("paused_at")
  pausedByAccountId String?   @map("paused_by_account_id")
  reason            String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("system_state")
}

/**
 * History is the table: a new version is a new row with the instant it takes
 * effect, never an update in place, so what was in force on any past day is
 * always answerable.
 */
model ProtocolParameterVersion {
  id                 String   @id
  effectiveAt        DateTime @map("effective_at")
  writtenByAccountId String   @map("written_by_account_id")
  parameters         Json
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([effectiveAt])
  @@map("protocol_parameter_version")
}

/**
 * An event the drain could not deliver after every retry. It leaves the
 * queue so the queue keeps moving, and waits for a human.
 */
model DeadLetterEvent {
  id             String   @id
  outboxId       String   @map("outbox_id")
  type           String
  payload        Json
  attempts       Int
  lastError      String   @map("last_error")
  deadLetteredAt DateTime @map("dead_lettered_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("dead_letter_event")
}

model OutboxEvent {
  id          String    @id
  type        String
  payload     Json
  occurredAt  DateTime  @map("occurred_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  /**
   * Set when a drain takes the row. A row lock only reserves for the life of
   * its transaction, so without this a second drain could take the same
   * event the moment the first committed.
   */
  claimedAt   DateTime? @map("claimed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([publishedAt, claimedAt])
  @@map("outbox_event")
}

model IdempotencyRecord {
  id           String   @id
  key          String
  accountId    String   @map("account_id")
  requestHash  String   @default("") @map("request_hash")
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([key, accountId])
  @@index([expiresAt])
  @@map("idempotency_record")
}

model AuditLog {
  id          String   @id
  actorType   String   @map("actor_type")
  actorId     String   @map("actor_id")
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  action      String
  before      Json?
  after       Json?
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([actorId])
  @@index([subjectId])
  @@map("audit_log")
}

/// The offset a demo process adds to the system clock. One row, written when
/// the seed or an operator pushes time forward, read once at startup so a
/// restart does not undo the demo.
model DemoClock {
  id        String   @id
  offsetMs  BigInt   @map("offset_ms")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("demo_clock")
}

model ChainDeployment {
  id                     String   @id
  network                String
  packageId              String   @map("package_id")
  configId               String   @map("config_id")
  adminCapId             String   @map("admin_cap_id")
  operatorCapId          String   @map("operator_cap_id")
  custodianCapId         String   @map("custodian_cap_id")
  treasuryCapId          String?  @map("treasury_cap_id")
  settlementCoinType     String   @map("settlement_coin_type")
  settlementCoinDecimals Int      @map("settlement_coin_decimals")
  publishedAt            DateTime @map("published_at")
  publishedBy            String   @map("published_by")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("chain_deployment")
}

model ChainAccountAddress {
  accountId String   @id @map("account_id")
  address   String   @unique
  source    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("chain_account_address")
}

model ChainWallet {
  id           String   @id
  accountId    String   @map("account_id")
  currency     String
  address      String
  objectId     String?  @unique @map("object_id")
  openedDigest String?  @map("opened_digest")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([accountId, currency])
  @@map("chain_wallet")
}

model ChainEvent {
  id         String   @id
  checkpoint BigInt?
  digest     String
  eventIndex Int      @map("event_index")
  module     String
  eventType  String   @map("event_type")
  sender     String
  json       Json
  ingestedAt DateTime @map("ingested_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([module, checkpoint])
  @@index([digest])
  @@map("chain_event")
}

model ChainIndexerCursor {
  module        String   @id
  newestEventId String?  @map("newest_event_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("chain_indexer_cursor")
}
